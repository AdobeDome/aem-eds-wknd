{
  "definitions": [
    {
      "title": "Page",
      "id": "page",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/page/v1/page",
            "template": {
              "name": "Page",
              "model": "page-metadata"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "page-metadata",
      "fields": [
        {
          "component": "tab",
          "label": "Basic",
          "name": "tab-basic"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "jcr:title",
          "label": "Title"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "jcr:description",
          "label": "Description"
        },
        {
          "component": "aem-content-fragment",
          "name": "theme_cf_reference",
          "label": "Brand Theme",
          "description": "Select the CF with authored values for the brand theme. This will be applied on the pages",
          "valueType": "string",
          "validation": {
              "rootPath": "/content/dam"
          }
        },
        {
            "component": "select",
            "name": "theme",
            "label": "Theme",
            "description": "Note: This takes priority over CF based theme.",
  
            "options": [
              {
                "name": "default",
                "value": ""
              },
              {
                "name": "Gray Theme",
                "value": "gray-theme"
              },
              {
                "name": "Red Theme",
                "value": "red-theme"
              },
              {
                "name": "Blue Theme",
                "value": "blue-theme"
              },
               {
                "name": "Green Theme",
                "value": "green-theme"
              },
              {
                "name": "WeHealthcare Theme",
                "value": "wehealthcare-theme"
              }
            ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "js-files",
          "multi": true,
          "value": "",
          "label": "JS Library URL(s)",
          "description": "List of js libraries to include under head section of the page"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "jcr:pagetitle",
          "label": "Page Title"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "pageCategory",
          "label": "Page Category"
        },
        {
          "component": "aem-tag",
          "name": "cq:tags",
          "label": "Tags",
          "valueType": "string",
          "rootPath": "/content/cq:tags/reference-demo"
        }
      ]
    }
  ],
  "filters": []
}